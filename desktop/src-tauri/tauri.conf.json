{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cloud Voice Studio",
  "version": "0.1.0",
  "identifier": "com.cloudvoice.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cloud Voice Studio",
        "width": 1180,
        "height": 780,
        "minWidth": 940,
        "minHeight": 640,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --use-fake-ui-for-media-stream"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost blob:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost",
      "assetProtocol": { "enable": true, "scope": ["$APPDATA/**", "$APPCACHE/**", "$TEMP/**", "$DOWNLOAD/**"] }
    }
  },
  "bundle": { "active": true, "targets": ["nsis"] }
}
